<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="pnt_product_code_report" model="ir.actions.report">
            <field name="name">Códigos de producto</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_azarey.product_code_report</field>
            <field name="report_file">custom_azarey.product_code_report</field>
            <field name="print_report_name">((str(object.name) or ''))</field>
            <field name="attachment">((str(object.name) or '')+'.pdf')</field>
            <field name="binding_model_id" ref="model_sale_order"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>
<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="account_payment_mode_form_inh" model="ir.ui.view">
        <field name="name">Account Payment Mode Form</field>
        <field name="model">account.payment.mode</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="account_payment_partner.account_payment_mode_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='show_bank_account']" position="before">
                <field name="pnt_print_reference_invoice"/>
            </xpath>
        </field>
        <field name="priority">99</field>
    </record>


</odoo>

<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="pnt_dachser_stock_view_picking_form_inh" model="ir.ui.view">
        <field name="name">pnt.dachser.stock.view.picking.form.inh</field>
        <field name="model">stock.picking</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Dascher params" name="dascher_params"  attrs="{'invisible': [('picking_type_code','!=','outgoing')]}">
                    <group>
                        <group string="Other Information" name="other_infos">

                             <field name="dachser_document"/>

                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>


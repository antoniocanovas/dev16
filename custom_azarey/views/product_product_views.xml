<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="product_product_sale_azarey_inh_form" model="ir.ui.view">
        <field name="name">product.product.sale.azarey.inh.form</field>
        <field name="model">product.product</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="sale.product_form_view_sale_order_button"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page name="sale_order_lines" string="Sale order lines">
                    <field name="pnt_sale_line_ids" nolabel="1" colspan="4">
                        <tree>
                            <field name="order_id"/>
                            <field name="salesman_id"/>
                            <field name="product_uom_qty"/>
                            <field name="create_date" widget="date"/>
                            <field name="state"/>
                        </tree>
                    </field>
                    <button class="oe_highlight" type="object" string="Sale lines as notes"
                            name="delete_product_archived_in_sale_line"
                            attrs="{'invisible':[('pnt_sale_line_ids','=',[])]}"/>
                </page>
            </xpath>

        </field>
    </record>

    <record id="pnt_reservation_history_tree" model="ir.ui.view">
        <field name="name">reservation.history.tree</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <tree create="false" default_order="order_id asc">
                <field name="order_id" widget="many2one"/>
                <field name="product_uom_qty"/>
                <field name="price_unit"/>
            </tree>
        </field>
    </record>

     <record id="action_resevation_history" model="ir.actions.act_window">
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="pnt_reservation_history_tree"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Reservations were made for this product yet!
            </p>
        </field>
    </record>

    <record id="product_product_reservation_azarey_inh_form" model="ir.ui.view">
        <field name="name">product.product.reservation.azarey.inh.form</field>
        <field name="model">product.product</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_view_reservations" type="object" icon="fa-signal" help="Reserved in the last 365 days" groups="sales_team.group_sale_salesman" attrs="{'invisible': [('sale_ok', '=', False)]}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="pnt_reservation_count" widget="statinfo" nolabel="1" class="mr4"/>
                        </span>
                        <span class="o_stat_text">Reserved</span>
                    </div>
                </button>
            </xpath>

        </field>
    </record>

    <record id="action_product_image_download" model="ir.actions.server">
        <field name="name">Download Images</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="state">code</field>
        <field name="code">
            if records:
            action = records.action_product_iamges_download()
        </field>
    </record>

</odoo>

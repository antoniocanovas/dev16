<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="credentials_category" model="ir.module.category">
            <field name="name">Credentials</field>
        </record>

        <record id="user_credentials_group" model="res.groups">
            <field name="name">User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root'))]"/>
            <field name="category_id" ref="credentials_category"/>
        </record>

        <record id="admin_credentials_group" model="res.groups">
            <field name="name">Administrator</field>
            <field name="implied_ids" eval="[(4, ref('user_credentials_group'))]"/>
            <field name="users" eval="[(4, ref('base.user_root'))]"/>
            <field name="category_id" ref="credentials_category"/>
        </record>

</odoo>
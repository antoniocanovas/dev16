<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="credential_category" model="ir.module.category">
            <field name="name">Credentials</field>
        </record>

        <record id="user_credential_group" model="res.groups">
            <field name="name">User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
            <field name="category_id" ref="credential_category"/>
        </record>

        <record id="admin_credential_group" model="res.groups">
            <field name="name">Administrator</field>
            <field name="implied_ids" eval="[(4, ref('user_credential_group'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
            <field name="category_id" ref="credential_category"/>
        </record>

</odoo>
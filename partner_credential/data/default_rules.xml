<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.rule" id="admin_credential">
        <field name="name">admin credentials rule</field>
        <field name="model_id" ref="model_partner_credential"></field>
        <field name="domain_force">[(1,'=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('partner_credential.admin_credential_group')])]"/>
        <field eval="1" name="perm_write"></field>
        <field eval="1" name="perm_read"></field>
        <field eval="1" name="perm_unlink"></field>
        <field eval="1" name="perm_create"></field>
    </record>

    <record model="ir.rule" id="user_partner_credential_read">
        <field name="name">user credentials rule</field>
        <field name="model_id" ref="model_partner_credential"></field>
        <field name="domain_force">[ '|', '|', '|', ('user_ids','in',user.id), ('public','=',True), ('create_uid','=',user.id),('message_partner_ids','in', [user.partner_id.id])]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]" />
        <field eval="1" name="perm_write"></field>
        <field eval="1" name="perm_read"></field>
        <field eval="0" name="perm_unlink"></field>
        <field eval="1" name="perm_create"></field>
    </record>

    <record model="ir.rule" id="user_partner_credential_delete">
        <field name="name">user credentials delete</field>
        <field name="model_id" ref="model_partner_credential"></field>
        <field name="domain_force">[('create_uid','=',user.id)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]" />
        <field eval="0" name="perm_write"></field>
        <field eval="0" name="perm_read"></field>
        <field eval="1" name="perm_unlink"></field>
        <field eval="0" name="perm_create"></field>
    </record>

</odoo>
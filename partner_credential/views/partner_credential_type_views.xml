<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="credential_type_tree" model="ir.ui.view">
        <field name="arch" type="xml">
            <tree string="Credentials type">
                <field name="name"/>
                <field name="department_ids" widget="many2many_tags"/>
                <field name="create_uid" widget="many2one_avatar_user" optional="show"/>
            </tree>
        </field>
        <field name="model">partner.credential.type</field>
        <field name="name">Default tree view for partner credentials type</field>
        <field name="type">tree</field>
    </record>

</odoo>
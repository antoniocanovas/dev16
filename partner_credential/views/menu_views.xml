<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_credential" model="ir.actions.act_window">
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">action</field>
        <field name="domain" eval="False"/>
        <field name="filter" eval="False"/>
        <field name="limit">80</field>
        <field name="name">Credentials</field>
        <field name="res_model">partner.credential</field>
        <field name="search_view_id" eval="False"/>
        <field name="target">current</field>
        <field name="type">ir.actions.act_window</field>
        <field name="usage" eval="False"/>
        <field name="view_id" eval="False"/>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_credential_category" model="ir.actions.act_window">
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">action</field>
        <field name="domain" eval="False"/>
        <field name="filter" eval="False"/>
        <field name="limit">80</field>
        <field name="name">Credentials category</field>
        <field name="res_model">partner.credential.category</field>
        <field name="search_view_id" eval="False"/>
        <field name="target">current</field>
        <field name="type">ir.actions.act_window</field>
        <field name="usage" eval="False"/>
        <field name="view_id" eval="False"/>
        <field name="view_mode">tree</field>
    </record>

    <record id="view_search_partner_credential" model="ir.ui.view">
            <field name="name">partner.credential.search</field>
            <field name="model">partner.credential</field>
            <field name="arch" type="xml">
                <search string="Partner Credential">
            <field name="name" string="Credential" filter_domain="['|','|',('name','ilike',self),('category','ilike',self),('partner_id','child_of',self)]"/>
    </search>
            </field>
        </record>

    <menuitem
            action="action_credential"
            id="menu_partner_credential"
            name="Credentials"
            sequence="1"
            web_icon="partner_credential,static/description/credentials.png"
    />

    <record id="menu_main_partner_credential" model="ir.ui.menu">
        <field name="action" ref="action_credential"/>
        <field name="active" eval="True"/>
        <field name="name">Credentials</field>
        <field name="parent_id" ref="menu_partner_credential"/>
        <field name="sequence">10</field>
        <field name="web_icon" eval="False"/>
    </record>

    <record id="menu_main_partner_credential_category" model="ir.ui.menu">
        <field name="action" ref="action_credential_category"/>
        <field name="active" eval="True"/>
        <field name="name">Categories</field>
        <field name="parent_id" ref="menu_partner_credential"/>
        <field name="sequence">20</field>
        <field name="web_icon" eval="False"/>
    </record>

</odoo>